Bootstrap: docker
From: mambaorg/micromamba

%help
    This container provides the doublets environment for the QC pipeline.

%files
    envs/doublets.yml /opt/env.yml

%environment
    export PATH="/opt/env/bin:$PATH"
    export CONDA_PREFIX="/opt/env"

%post
    apt-get update && apt-get install -y procps

    CONDA_OVERRIDE_CUDA=12.9 micromamba create -q -y -f /opt/env.yml -p /opt/env

    micromamba clean -aqy

    micromamba config set --system use_lockfiles false

%runscript
    exec "$@"
