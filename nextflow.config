/*
* Pipeline parameters
*/

manifest {
    name            = 'lipovseklab/qc-pipeline'
    description     = 'QC pipeline for mouse utricle single-cell data: cell calling, doublet detection, minimal filtering, dimensionality reduction, clustering and outlier removal.'
    homePage        = 'https://github.com/lipovseklab/qc-pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version         = '1.0.0dev'
}

plugins {
    id 'nf-schema@2.5.1'    // validates run.yaml against nextflow_schema.json
}

validation {
    // nf-schema's unrecognised-parameter check flattens the `datasets` list and wrongly reports every valid key;
    // the dataset entries are still type-checked by the schema, and unknown keys are rejected in main.nf.
    // config_profile_* are set by the ucl_myriad profile (nf-core institutional config) and are not pipeline settings.
    ignoreParams = ['datasets', 'config_profile_description', 'config_profile_contact', 'config_profile_url']
    // stop on a misspelt top-level setting (e.g. `outdri:`) instead of warning and running with the default
    logging {
        unrecognisedParams = 'error'
    }
}

params {
    // which part to run: qc | outliers | all (qc then outliers) | cnmf | consensus | analysis
    step                    = null
    // one dataset (list with one entry) — see nextflow_schema.json and examples/*.yaml
    datasets                = null
    // output directory
    outdir                  = "results"
    // cNMF analysis step: reference files, downloaded once with `python bin/fetch_resources.py` (needs internet)
    gmt                     = "${projectDir}/assets/resources/MOUSE_GO_bp_no_GO_iea_symbol.gmt"
    collectri               = "${projectDir}/assets/resources/collectri_mouse.parquet"
    // folder holding the apptainer images (utricle-qc.sif, r-clustering.sif, vaeda.sif, cellbender.sif,
    // and for the cNMF steps cnmf_env.sif, cnmf-analysis.sif, clustree.sif; see bin/helpers/setup-containers.sh).
    // The .sif files are not in git: set this per machine (profiles) or in run.yaml.
    container_dir           = "${projectDir}/containers"
    // run even if the pipeline code has uncommitted changes (recorded in pipeline_info/provenance.json)
    allow_dirty             = false
    // suffix for the timeline/trace/dag/report files in pipeline_info/
    trace_report_suffix     = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

/*
* Containers setup
*/

apptainer {
    enabled    = true
    cacheDir   = "${System.getenv('HOME')}/.nextflow/apptainer"
    runOptions = "--writable-tmpfs"
}

/*
* Reporting
*/

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

/*
* Output settings
*/

workflow.output.mode = 'copy'

/*
* Process settings
*/

includeConfig 'conf/base.config'

/*
* Profiles
*/

profiles {
    // tiny bundled test dataset (stub runs / CI)
    test {
        includeConfig 'conf/test.config'
    }
    // UCL Myriad (SGE). Dataset settings never go in profiles: they live in run.yaml.
    ucl_myriad {
        includeConfig 'conf/ucl_myriad.config'
    }
}

// Set last, so it follows params.outdir however it was given (run.yaml, profile or command line).
outputDir = params.outdir
