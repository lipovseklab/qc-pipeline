nextflow_pipeline {

    name "Test Workflow main.nf"
    script "../main.nf"

    test("step all: qc then outliers (stub)") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
                step   = 'all'
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/qc/anndatas/adata_doublets.h5ad").exists()
            assert path("$outputDir/outliers/anndatas/adata_final_filter_test.h5ad").exists()
            def prov = path("$outputDir/pipeline_info/provenance.json").json
            assert prov.status == 'completed'
            assert prov.pipeline.commit
            assert prov.dataset.name == 'test'
        }
    }

    test("step qc with CellBender (stub)") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'qc'
                datasets = [[
                    name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                    celltype_csv: "${projectDir}/test/celltype_test.csv",
                    skip_cellbender: false, skip_scSHC: true,
                ]]
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/qc/plots/cellcalling/plot_barcode_rank_plate.png").exists()
            assert path("$outputDir/qc/reports/cellbender/cellbender_stub_batch_1_report.html").exists()
            assert path("$outputDir/qc/reports/cellbender/cellbender_stub_batch_2_report.html").exists()
            assert path("$outputDir/qc/anndatas/adata_doublets.h5ad").exists()
        }
    }

    test("step qc only (stub)") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
                step   = 'qc'
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/qc/anndatas/adata_doublets.h5ad").exists()
            assert !path("$outputDir/outliers").exists()
        }
    }

    test("step outliers only, with qc_stats (stub)") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'outliers'
                datasets = [[
                    name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                    celltype_csv: "${projectDir}/test/celltype_test.csv",
                    clusters: 'topo_clusters_ms_res0.4', skip_scSHC: true,
                    qc_stats: "${projectDir}/test",
                ]]
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/outliers/anndatas/adata_final_filter_test.h5ad").exists()
            assert !path("$outputDir/qc").exists()
        }
    }

    test("misspelt dataset setting is rejected") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'qc'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              celltype_csv: "${projectDir}/test/celltype_test.csv", clusterz: 'x' ]]
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains('Unknown dataset setting') } || workflow.stderr.any { it.contains('Unknown dataset setting') }
        }
    }

    test("blank required setting is rejected") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'all'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              celltype_csv: "${projectDir}/test/celltype_test.csv", clusters: ' ' ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('is missing: clusters') }
        }
    }

    test("dataset name with a path separator is rejected") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'qc'
                datasets = [[ name: 'donor/1', adata: "${projectDir}/test/adata_test.h5ad",
                              celltype_csv: "${projectDir}/test/celltype_test.csv" ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Dataset name 'donor/1'") }
        }
    }

    test("misspelt top-level setting is rejected") {
        options "-stub-run"
        when {
            params {
                outdri   = "$outputDir"
                step     = 'qc'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              celltype_csv: "${projectDir}/test/celltype_test.csv" ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('outdri') }
        }
    }

    test("multi-line setting is rejected") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'all'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              celltype_csv: "${projectDir}/test/celltype_test.csv", clusters: "topo_clusters_ms_res0.4\njunk\n" ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('must not be blank or contain spaces: clusters') }
        }
    }

    // ---- cNMF ----

    test("step cnmf: two subsets and the whole dataset (stub)") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'cnmf'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              cnmf: [ column: 'sample', k: [2, 3], n_iters: 5, stride: 4,
                                      subsets: [[value: 'LN_A'], [value: 'LN B', k: [4]], [:]] ] ]]
            }
        }
        then {
            assert workflow.success
            // 'LN B' becomes the folder sample_LN_B; the whole dataset uses the dataset name
            ['sample_LN_A', 'sample_LN_B', 'test'].each { tag ->
                assert path("$outputDir/cnmf/${tag}/pipeline_info/run_name.txt").exists()
                assert path("$outputDir/cnmf/${tag}/hvgs_${tag}.csv").exists()
                assert path("$outputDir/cnmf/${tag}/anndatas/adata_topometry_${tag}.h5ad").exists()
                assert path("$outputDir/cnmf/${tag}/clustering/clustree_topo_ms.png").exists()
            }
            assert path("$outputDir/cnmf/sample_LN_A/anndatas/adata_sample_LN_A.h5ad").exists()
            // factorize chunks: (2 k x 5) / 4 -> 3, (1 x 5) / 4 -> 2, (2 x 5) / 4 -> 3
            assert workflow.trace.tasks().findAll { it.name.contains('cnmf_factorize') }.size() == 8
            assert path("$outputDir/pipeline_info/provenance.json").json.status == 'completed'
        }
    }

    test("step consensus: only subsets with a selected_k (stub)") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'consensus'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              cnmf: [ column: 'sample', k: [2, 3],
                                      subsets: [[value: 'LN_A', selected_k: 3, threshold: 0.5], [value: 'LN_C']] ] ]]
            }
        }
        then {
            assert workflow.success
            // LN_C has no selected_k, so only LN_A runs
            assert workflow.trace.tasks().findAll { it.name.contains('cnmf_consensus') }.size() == 1
            assert workflow.trace.tasks().findAll { it.name.contains('cnmf_refit_usage') }.size() == 1
        }
    }

    test("step analysis (stub)") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'analysis'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              cnmf: [ column: 'sample', subsets: [[value: 'LN_A', selected_k: 3, clusters: 'topo_clusters_ms_res0.6']] ] ]]
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/cnmf/sample_LN_A/analysis/analysis_call.txt").exists()
        }
    }

    test("consensus without any selected_k is rejected") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'consensus'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              cnmf: [ column: 'sample', subsets: [[value: 'LN_A']] ] ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('no subset has a selected_k yet') }
        }
    }

    test("cnmf settings are checked") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'cnmf'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              cnmf: [ column: 'sample', subsets: [[value: 'LN_A', n_iter: 5]] ] ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('Unknown setting(s) in cnmf.subsets[0] (value LN_A): n_iter') }
        }
    }

    test("a subset needs a column") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'cnmf'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad",
                              cnmf: [ subsets: [[value: 'LN_A']] ] ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('a subset needs `column`') }
        }
    }

    test("cnmf steps need a cnmf block") {
        options "-stub-run"
        when {
            params {
                outdir   = "$outputDir"
                step     = 'cnmf'
                datasets = [[ name: 'test', adata: "${projectDir}/test/adata_test.h5ad" ]]
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('needs a `cnmf:` block') }
        }
    }
}
