/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// Stub tests need no container images (CI has none) and run from a working copy.
apptainer.enabled = false
params.allow_dirty = true
// GitHub's runners have 4 cpus and 16 GB; cap the requests (e.g. cnmf_topometry asks for 8 cpus)
process.resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
