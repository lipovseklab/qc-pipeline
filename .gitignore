.nextflow*
work/
data/
results*/
.DS_Store
testing/
testing*
*.pyc
__pycache__/
.vscode/

# nf-test run artifacts
.nf-test/
.nf-test.log

# conf: keep only the test, ucl_myriad, and base config files (dataset settings live in run.yaml files, not here)
conf/*
!conf/test.config
!conf/ucl_myriad.config
!conf/base.config

# containers: keep only the .def build recipes, not the built .sif images
containers/*.sif

# test: exclude the extra tiny/dev h5ad not part of the two required test files
test/adata_test_tiny.h5ad
