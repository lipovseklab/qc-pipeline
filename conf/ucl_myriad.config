/*
* ucl_myriad profile: University College London Myriad, new operating system and Slurm scheduler ("myriad-ng",
* RHEL 9; the old SGE half of Myriad is being retired). Log in to myriad-ng.rc.ucl.ac.uk and load Java 17+
* before running Nextflow (the system Java is 8), e.g. `module load openjdk/21.0.3_9/gcc-12.3.0-kx7sucd`.
* https://www.rc.ucl.ac.uk/docs/Clusters/Myriad/  https://www.rc.ucl.ac.uk/docs/Supplementary/Slurm/
*/

params {
    config_profile_description = 'University College London Myriad cluster (Slurm)'
    config_profile_contact     = 'rc-support@ucl.ac.uk'
    config_profile_url         = 'https://www.rc.ucl.ac.uk/docs/Clusters/Myriad/'
    // built .sif images (bin/helpers/setup-containers.sh --dest ~/Scratch/containers, or copied from a workstation);
    // run.yaml can override it
    container_dir              = "${System.getenv('HOME')}/Scratch/containers"
}

executor {
    name            = 'slurm'
    queueSize       = 800       // cNMF factorize submits hundreds of jobs
    submitRateLimit = '10/1s'   // eases pressure on the scheduler
    pollInterval    = '30 sec'
    queueStatInterval = '1 min'
}

process {
    // Nextflow passes cpus, memory (--mem, total per task) and time to sbatch. Myriad has no default walltime, so
    // processes that set none get this one (the labels in conf/base.config override it). Jobs on 2+ cores are
    // limited to 48 h on Myriad.
    time    = 24.h
    scratch = false
    // Myriad picks a QOS that needs 2+ cores unless a 1-core job asks for the 1-core QOS (max 72 h)
    clusterOptions = { task.cpus == 1 ? '--qos=<1-core QOS>' : '' }

    // QC and outlier steps: sizes from the paper runs (peak RSS in brackets), with headroom.
    // Slurm's default would be 1 GB per core. Most Myriad nodes have 36 cores and 160 GB; a few have 1.5 TB.
    withName: 'cell_typing|combine_clusters|combine_doublets|minimal_filter|prep_doublets|outlier_filter|qc_.*|report_.*|filtering_summary|plt_proportion|plot_barcode_rank|get_batches|split_adata|join_adatas' {
        cpus   = 1
        memory = { 24.GB * task.attempt }     // (<= 16.6 GB)
        time   = { 2.h * task.attempt }       // (<= 3 min)
    }
    withName: clustree {
        cpus   = 1
        memory = { 48.GB * task.attempt }     // (33.8 GB)
        time   = { 2.h * task.attempt }       // (7 min)
    }
    withName: run_topometry {
        cpus   = 8
        memory = { 64.GB * task.attempt }     // (43.5 GB)
        time   = { 12.h * task.attempt }      // (3.5 h on ~4.4 cores)
    }
    withName: run_vaeda {
        cpus   = 8
        memory = { 40.GB * task.attempt }     // (24.3 GB)
        time   = { 6.h * task.attempt }       // (1.6 h on ~6 cores)
    }
    withName: run_scDblFinder {
        cpus   = 8
        memory = { task.attempt == 1 ? 150.GB : 400.GB }   // (118.6 GB); a retry needs a 1.5 TB node
        time   = { 4.h * task.attempt }       // (46 min on ~4.6 cores)
    }
    // a profile withName block replaces the conf/base.config block for the same process, so its settings are repeated
    withName: scSHC {
        cpus   = 10
        memory = 128.GB
        time   = 12.h
    }
    withName: run_cellbender {
        queue          = 'gpu'
        clusterOptions = '--gres=gpu:1'   // any of Myriad's V100 / A100 types
        containerOptions = '--nv'         // each job has its own GPU, so no maxForks = 1 as on a workstation
        cpus           = 4
        memory         = 32.GB
        time           = 12.h
    }
    withName: 'cell_typing|combine_clusters|combine_doublets|minimal_filter|prep_doublets|outlier_filter|qc_.*|report_.*|filtering_summary|plt_proportion|plot_barcode_rank|get_batches|split_adata|join_adatas|clustree|run_topometry|run_vaeda|run_scDblFinder' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + Integer.MAX_VALUE) ? 'retry' : 'finish' }
        maxRetries    = 1
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/Scratch/.apptainer/pull"
    runOptions = "-B ${System.getenv('HOME')},${System.getenv('PWD')} --no-mount /scratch --writable-tmpfs"
}
