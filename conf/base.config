/*
* Base process resource / container-option overrides.
* The ucl_myriad profile owns the executor and the container engine; memory is the TOTAL per task (the profile
* divides it by cpus for the per-core request).
*/

// anndata: allow writing nullable string columns (needed by the cNMF subset/topometry outputs)
env {
    ANNDATA_ALLOW_WRITE_NULLABLE_STRINGS = '1'
}

process {
    withName: run_cellbender {
        // Run one batch at a time so parallel jobs don't exhaust the GPU.
        maxForks = 1
        containerOptions = '--nv --nvccli'
    }
    // run_vaeda runs on the CPU: the paper run did (its TensorFlow found no CUDA libraries), and a GPU test run on
    // the paper data ran out of GPU memory (2026-11-24 benchmark, CHANGELOG)
    withName: scSHC {
        memory = '128 GB'
        cpus = 10
    }

    // ---- cNMF (sizes from the 2026 Myriad runs on the paper subsets) ----
    // retry with more resources on OOM / walltime kills (137-140 SGE, 143-145 signals, 104) and on jobs SGE lost
    // (no exit status read back: Integer.MAX_VALUE)
    withName: 'cnmf_.*' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + Integer.MAX_VALUE) ? 'retry' : 'finish' }
        maxRetries    = 1
    }
    withLabel: cnmf_small {         // subset (peak 1.1 GB), prep (<= 0.5 GB), cluster comparison, clustree
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 15.min * task.attempt }
    }
    withLabel: cnmf_topometry {     // peak RSS 2.2-3.4 GB, ~3.6 cores on average, 7-13 min (3 subsets)
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: cnmf_factorize {     // one task runs `stride` iterations (up to ~30 min each)
        cpus          = 1
        memory        = { 2.GB * task.attempt }
        time          = { 6.h * task.attempt }
        errorStrategy = 'retry'     // completed iterations are skipped on retry
    }
    withLabel: cnmf_combine {       // reads every factorize result: grows with k values x iterations
        cpus       = 1
        memory     = { 4.GB * task.attempt }
        time       = { 1.h * task.attempt }
        maxRetries = 2
    }
    withLabel: cnmf_consensus {     // consensus and usage refit, HC subset: 1.8 GB peak, ~0.6 cores
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withLabel: cnmf_analysis {      // 7-13k cells: 3.0-3.7 GB peak, 6-12 min (mostly the DGE)
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
