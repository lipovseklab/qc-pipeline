/*
* Test profile — tiny bundled dataset (stub runs / CI). Equivalent to a run.yaml with these settings.
*/

params {
    step     = 'all'
    outdir   = 'results_test'
    datasets = [[
        name         : 'test',
        adata        : "${projectDir}/test/adata_test.h5ad",
        celltype_csv : "${projectDir}/test/celltype_test.csv",
        batch        : 'plate',
        sample       : 'sample',
        clusters     : 'topo_clusters_ms_res0.4',
        skip_scSHC   : true,
    ]]
}
